@startuml
' Set standard layout
skinparam classAttributeIconSize 0

class User {
    + name : string
    + email : string
    + role : string
    + is_active : boolean
    + casts() : array
    + scopeAdmin(query)
    + scopeChef(query)
    + isAdmin() : bool
    + isChef() : bool
}

class Product {
    + name : string
    + description : text
    + category : string
    + unit : string
    + qty : decimal
    + min_qty : decimal
    + price_per_unit : decimal
    + casts() : array
    + stockLogs() : HasMany
    + scopeLowStock(query)
    + getStockStatus() : string
}

class Recipe {
    + name : string
    + description : text
    + category : string
    + default_portions : int
    + created_by : bigint
    + is_active : boolean
    + casts() : array
    + creator() : BelongsTo
    + ingredients() : HasMany
    + products() : BelongsToMany
    + scopeActive(query)
    + getCostPerPortionAttribute() : float
}

class RecipeIngredient {
    + recipe_id : bigint
    + product_id : bigint
    + qty_per_portion : decimal
    + note : string
    + recipe() : BelongsTo
    + product() : BelongsTo
}

class StockLog {
    + product_id : bigint
    + user_id : bigint
    + type : string
    + qty_before : decimal
    + qty_changed : decimal
    + qty_after : decimal
    + unit : string
    + recipe_id : bigint
    + portions : int
    + note : text
    + casts() : array
    + product() : BelongsTo
    + user() : BelongsTo
    + recipe() : BelongsTo
    + scopeOfType(query, type)
    + scopeForProduct(query, productId)
}

' Definisi Asosiasi / Hubungan Class Model Eloquent
User "1" -- "0..*" Recipe : "creates"
User "1" -- "0..*" StockLog : "manages"
Product "1" -- "0..*" StockLog : "tracks"
Product "1" -- "0..*" RecipeIngredient : "supplies"
Recipe "1" -- "0..*" RecipeIngredient : "has"
Recipe "1" -- "0..*" StockLog : "logs"

@endum