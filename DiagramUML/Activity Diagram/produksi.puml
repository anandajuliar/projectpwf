    else (Tidak)
        :Potong semua stok bahan baku terkait;
        :Simpan log riwayat produksi;
        
        |System|
        :Tutup pop-up modal resep;
        :Munculkan Toast hijau sukses;
        :Muat ulang halaman;
        |User|
        :Melihat halaman ter-refresh dengan stok baru;
        stop
    endif
endif
@enduml