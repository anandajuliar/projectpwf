@startuml
|User (Chef)|
start
:Membuka menu "Cek Sisa Stok";

|System|
:Memuat data seluruh bahan baku;
|Database|
:Query tabel 'products' (nama, kategori, sisa stok);
|System|
:Render kartu stok dengan indikator status ("STOK AMAN");

|User (Chef)|
:Klik tombol "Gunakan Bahan" pada item yang dipilih;
|System|
:Munculkan Modal "Gunakan Bahan" berisi detail item & stok saat ini;

|User (Chef)|
:Menginput "Jumlah yang Digunakan" (mendukung angka desimal);\n(Opsional) Mengisi kolom "Catatan";
:Klik tombol "Potong Stok";

|System|
:Validasi input (pastikan berupa angka dan > 0);
if (Apakah input valid?) then (Tidak)
    :Tampilkan pesan error validasi di form;
    stop
else (Ya)
    |Database|
    :Cek apakah sisa stok mencukupi;
    if (Stok mencukupi?) then (Tidak)
        |System|
        :Tampilkan pesan error "Stok tidak mencukupi";
        stop
    else (Ya)
        |Database|
        :Kurangi kuantitas produk di tabel 'products';
        :Simpan log pemakaian bahan baku;
        |System|
        :Tutup Modal;
        :Panggil tampilToast('success', ...);
        :Menampilkan Toast hijau sukses di bawah kanan;
        :Panggil fetchProducts() untuk update sisa stok secara gaib;
        |User (Chef)|
        :Melihat angka sisa stok di kartu langsung berkurang;
        stop
    endif
endif
@enduml