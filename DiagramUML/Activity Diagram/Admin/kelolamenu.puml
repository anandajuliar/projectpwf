@startuml kelolamenu Act Diagram
|Admin|
start
:Membuka menu Dapur Produksi;

if (Pilih Aksi?) then (Buat/Edit Resep)
    :Klik "+ Buat Resep Baru" atau icon "Edit";
    |System|
    :Munculkan Modal Form Resep;
    |Admin|
    :Input Nama, Kategori, Portorsi, Waktu,\ndan Deskripsi;
    :Klik "+ Tambah Bahan" (Komposisi);
    :Pilih Bahan Baku, Input Jumlah & Catatan;
    :Klik "Simpan Perubahan / Resep Baru";
    |System|
    :Validasi input & ketersediaan ID bahan;
    |Database|
    :Update/Insert tabel 'recipes';
    :Sync data ke tabel 'recipe_ingredients';
else (Hapus Resep)
    |Admin|
    :Klik link merah "Hapus Resep" di dalam modal;
    |System|
    :Konfirmasi penghapusan resep;
    |Database|
    :Hapus data resep & komposisi;
endif

|System|
:Tutup Modal;
:Tampilkan Toast Sukses;
:Jalankan muatResep() (Refresh kartu);
|Admin|
:Melihat perubahan kartu resep di layar;
stop
@enduml