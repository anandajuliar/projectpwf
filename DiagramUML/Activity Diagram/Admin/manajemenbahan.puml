@startuml
|Admin|
start
:Membuka menu Master Gudang;

if (Aksi?) then (Filter Status Stok)
    :Klik dropdown "Status Stok";
    :Pilih (Normal / Rendah / Habis);
    |System|
    :Request data berdasarkan filter;
    |Database|
    :Query products WHERE qty status;
    |System|
    :Render tabel sesuai kategori stok;
else (Tambah Bahan Baku)
    |Admin|
    :Klik "+ Tambah Bahan Baku";
    |System|
    :Munculkan Modal "Tambah Bahan Baku";
    |Admin|
    :Input Nama, Kategori, Satuan, Stok Awal,\nBatas Minimum, Harga, dan Deskripsi;
    :Klik "Simpan";
    |System|
    :Validasi tipe data (angka/string);
    |Database|
    :Insert data baru ke tabel 'products';
endif

|System|
:Panggil tampilToast('success', ...);
:Muat ulang data tabel gudang;
|Admin|
:Melihat list bahan baku terupdate;
stop
@enduml