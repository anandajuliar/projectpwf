@startuml kelolakaryawan Act
|Admin| 
start
:Membuka menu Akun Karyawan;

if (Pilih Aksi?) then (Daftarkan Chef Baru)
    :Klik "+ Daftarkan Chef Baru";
    |System|
    :Munculkan Modal "Pendaftaran Chef Baru";
    |Admin|
    :Input Nama, Email, dan Password;
    :Klik "Simpan Data";
    |System|
    :Validasi format email & password;
    |Database|
    :Simpan data user (role: Staf Dapur);
else (Cabut/Edit Akses)
    |Admin|
    :Klik "Cabut Akses" atau "Edit";
    |System|
    :Konfirmasi perubahan status akun;
    |Database|
    :Update status 'is_active' atau data user;
endif

|System|
:Menampilkan Toast Notifikasi Sukses;
:Update tabel "Daftar Pengguna Aktif";
|Admin|
:Melihat perubahan di tabel karyawan;
stop
@enduml